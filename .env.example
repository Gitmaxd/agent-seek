# Agent Seek environment variables (AGENT_SEEK_* product keys; Upstash uses official names)
YDC_API_KEY=
TYPESAFE_API_KEY=
AGENT_SEEK_API_KEY=dev-agent-seek-key-change-me
PORT=8787
AGENT_SEEK_DEFAULT_K=10
AGENT_SEEK_DEFAULT_MAX_CANDIDATES=50
AGENT_SEEK_MAX_CANDIDATES=100
AGENT_SEEK_CACHE_TTL_SEC=1800
AGENT_SEEK_LOG_LEVEL=info
CORS_ORIGIN=*
# Optional: inject into same-origin UI for demo (server serves UI; never expose YDC/TYPESAFE)
AGENT_SEEK_UI_API_KEY=
# Optional HMAC secret for OAuth access tokens (derived from AGENT_SEEK_API_KEY if empty)
AGENT_SEEK_TOKEN_SIGNING_KEY=
# Seeded public PKCE client for local pytest (no secret)
AGENT_SEEK_OAUTH_CLIENT_ID=agent-seek-test

# Optional Upstash Redis REST rate limiting (public live host). Official Upstash names.
# Both URL and token must be set to enable; if either is empty, rate limiting is off
# (no Redis calls). Identity is client IP (X-Forwarded-For rightmost public hop).
# Fail-closed: Redis/network errors while enabled return HTTP 503, not silent allow.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Burst guard for search + MCP search_web (requests / 60s sliding window)
AGENT_SEEK_RATE_LIMIT_PER_MIN=60
# Comma-separated client IPs that skip burst + website demo quota (operator only).
# AGENT_SEEK_RATE_LIMIT_ALLOWLIST=203.0.113.10
# Website lifetime demo quota master switch (case-insensitive: disabled | enabled).
# Code default is disabled — local/dev and non-demo deploys are unchanged.
# Live agentseek.dev sets AGENT_SEEK_DEMO_MODE=enabled at deploy time.
AGENT_SEEK_DEMO_MODE=disabled
# Per-IP lifetime search cap when demo mode is enabled (Upstash INCR, no TTL / no reset).
# Default 5. Set 0 to disable even when demo mode is on. Requires both Upstash REST vars.
# Applied to REST /v1/search, /api/v1/search, and MCP search_web (one shared per-IP counter).
# HTML UI uses the same REST allowance. Unauthenticated MCP helper tools do not consume it.
# Exhausted searches from that IP return HTTP 429 problem+json code=DEMO_EXHAUSTED (no Retry-After).
AGENT_SEEK_DEMO_SEARCH_LIMIT=5

# Optional: OpenAI Responses judge for evals/public_v1 only (not used by product search).
# Model pin is gpt-5.6-sol with reasoning.effort=medium (see evals/public_v1/README.md).
OPENAI_API_KEY=
